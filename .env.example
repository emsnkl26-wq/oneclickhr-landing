# Transactional email for the /contact form (Resend).
# All three are optional: without them the contact route logs the submission
# and returns success-with-a-note, so local development needs no secrets.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@oneclickhr.app
CONTACT_FROM_EMAIL=OneclickHR <noreply@oneclickhr.app>

# Public site origin. Defaults to https://oneclickhr.app when unset.
NEXT_PUBLIC_SITE_URL=https://oneclickhr.app
